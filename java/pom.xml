<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.crowecawcaw</groupId>
  <artifactId>snappea</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>

  <name>snappea</name>
  <description>Check the events your Java code emits against P specs: a JDK-only emitter for application
    code, and test helpers (any framework, plus JUnit 5) that run the snappea checker. The checker binary
    comes in the classifier jars natives-{linux,macos}-{x86_64,aarch64} and natives-windows-x86_64.</description>
  <url>https://github.com/crowecawcaw/snappea</url>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>crowecawcaw</id>
      <name>Stephen Crowe</name>
      <url>https://github.com/crowecawcaw</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/crowecawcaw/snappea.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/crowecawcaw/snappea.git</developerConnection>
    <url>https://github.com/crowecawcaw/snappea</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/crowecawcaw/snappea/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- natives profile: a folder holding <classifier>/snappea (or snappea.exe), one per platform -->
    <snappea.natives>${project.basedir}/natives</snappea.natives>
    <snappea.natives.staging>${project.build.directory}/natives</snappea.natives.staging>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- No runtime dependencies. These come with the user's test framework (JUnit 5, jqwik, ...). -->
    <dependency>
      <groupId>org.opentest4j</groupId>
      <artifactId>opentest4j</artifactId>
      <version>1.3.0</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.3</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Classifier jars with the checker binary, attached to this artifact:
        mvn -f java/pom.xml -Pnatives -Dsnappea.natives=DIR install
      DIR holds one folder per platform with the binary in it: DIR/natives-linux-x86_64/snappea,
      DIR/natives-windows-x86_64/snappea.exe, ... Missing platforms are skipped. Each jar holds
      io/github/crowecawcaw/snappea/native/<classifier>/snappea[.exe] and snappea.sha256 beside it.
    -->
    <profile>
      <id>natives</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>stage-natives</id>
                <phase>prepare-package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <delete dir="${snappea.natives.staging}"/>
                    <copy todir="${snappea.natives.staging}">
                      <fileset dir="${snappea.natives}" includes="natives-*/snappea,natives-*/snappea.exe"/>
                      <regexpmapper handledirsep="true" from="^(natives-[a-z0-9_-]+)/(snappea(\.exe)?)$"
                                    to="\1/io/github/crowecawcaw/snappea/native/\1/\2"/>
                    </copy>
                    <checksum algorithm="SHA-256" fileext=".sha256" pattern="{0}  {1}" forceoverwrite="yes">
                      <fileset dir="${snappea.natives.staging}" includes="**/snappea,**/snappea.exe"/>
                    </checksum>
                    <move todir="${snappea.natives.staging}">
                      <fileset dir="${snappea.natives.staging}" includes="**/snappea.exe.sha256"/>
                      <globmapper handledirsep="true" from="*snappea.exe.sha256" to="*snappea.sha256"/>
                    </move>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>natives-linux-x86_64</id>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-linux-x86_64</classifier>
                  <classesDirectory>${snappea.natives.staging}/natives-linux-x86_64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                </configuration>
              </execution>
              <execution>
                <id>natives-linux-aarch64</id>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-linux-aarch64</classifier>
                  <classesDirectory>${snappea.natives.staging}/natives-linux-aarch64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                </configuration>
              </execution>
              <execution>
                <id>natives-macos-x86_64</id>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-macos-x86_64</classifier>
                  <classesDirectory>${snappea.natives.staging}/natives-macos-x86_64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                </configuration>
              </execution>
              <execution>
                <id>natives-macos-aarch64</id>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-macos-aarch64</classifier>
                  <classesDirectory>${snappea.natives.staging}/natives-macos-aarch64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                </configuration>
              </execution>
              <execution>
                <id>natives-windows-x86_64</id>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-windows-x86_64</classifier>
                  <classesDirectory>${snappea.natives.staging}/natives-windows-x86_64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Sources and javadoc jars, which Maven Central requires. Signing and upload: the central profile. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Signing and upload to Maven Central (the Sonatype Central Portal). The release
      workflow runs:
        mvn -f java/pom.xml -Pnatives,release,central -Dsnappea.natives=DIR deploy
      It needs a GPG key in the agent (passphrase in MAVEN_GPG_PASSPHRASE) and a server
      "central" in settings.xml holding a Central Portal user token. Locally,
      -Dgpg.skip skips signing (use verify, not deploy). Kept out of `release` so CI
      builds the sources and javadoc jars without a key.
    -->
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <!-- Wait until the version is on Central, so a rejected upload fails the run. -->
              <waitUntil>published</waitUntil>
              <waitMaxTime>3600</waitMaxTime>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

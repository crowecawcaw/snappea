{
  "name": "p-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:html": "node --test scripts/check-static-pages.mjs",
    "test:replay": "node --experimental-strip-types --test scripts/replay.test.ts",
    "test:diagrams": "node --experimental-strip-types --test scripts/diagrams.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@d2lang/d2": "0.1.34",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }

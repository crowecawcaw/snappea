        "command": "snappea-compat check --help\ncat /opt/p-modeling/examples/reservation/test_storage.py\ncat > solution.py <<'EOF'\n\"\"\"Shared bounded FIFO. The Store record is the only authoritative state.\"\"\"\n\nclass Queue:\n    def __init__(self, store, capacity=2):\n        if not isinstance(capacity, int) or isinstance(capacity, bool) or capacity <= 0:\n            raise ValueError(\"capacity must be a positive integer\")\n        self._store = store\n        while True:\n            version, record = store.load()\n            if record is not None:\n                if record['capacity'] != capacity:\n                    raise ValueError(\"all queues sharing a Store must use its capacity\")\n                break\n            record = {'capacity': capacity, 'items': [], 'puts': {}, 'takes': {}}\n            if store.compare_swap(version, record):\n                break\n\n    def put(self, request_id, item: int) -> bool:\n        while True:\n            version, record = self._store.load()\n            if request_id in record['puts']:\n                old_item, accepted = record['puts'][request_id]\n                if old_item != item:\n                    raise ValueError(\"put request ID reused with a different item\")\n                return accepted\n            accepted = len(record['items']) < record['capacity']\n            if accepted:\n                record['items'].append(item)\n            record['puts'][request_id] = (item, accepted)\n            # Rejections also commit a memo. A loser reloads all current state.\n            if self._store.compare_swap(version, record):\n                return accepted\n\n    def take(self, request_id) -> int | None:\n        while True:\n            version, record = self._store.load()\n            if request_id in record['takes']:\n                return record['takes'][request_id]\n            result = record['items'].pop(0) if record['items'] else None\n            record['takes'][request_id] = result\n            if self._store.compare_swap(version, record):\n                return result\n\n    def snapshot(self) -> list[int]:\n        _, record = self._store.load()\n        return record['items']\nEOF\n",
